# Global Config connection strings (id + read token in URL). Set the shard(s) you use.

GLOBAL_CONFIG_REDIRECTS_1=https://global-config.vercel.com/ecfg_YOUR_ID?token=YOUR_READ_TOKEN
# GLOBAL_CONFIG_REDIRECTS_2=https://global-config.vercel.com/ecfg_YOUR_ID?token=YOUR_READ_TOKEN
# GLOBAL_CONFIG_REDIRECTS_3=https://global-config.vercel.com/ecfg_YOUR_ID?token=YOUR_READ_TOKEN

# Optional override if parsing the id from the connection string fails
# GLOBAL_CONFIG_ID=ecfg_YOUR_ID

# Required for create/update/delete (server-only; never NEXT_PUBLIC_)
VERCEL_API_TOKEN=

# Required when the Global Config belongs to a Vercel team (Settings → General → Team ID)
# VERCEL_TEAM_ID=team_

# Dashboard “Purge redirects cache” → headless POST /api/admin/global-config-redirects/revalidate
# NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# SITECORE_REVALIDATE_SECRET=
# VERCEL_AUTOMATION_BYPASS_SECRET=  # site Deployment Protection → sent as x-vercel-protection-bypass on purge
